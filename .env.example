# =========================================
# Environment variables for MCP Bridge
# Copy to .env and fill in your values
# =========================================

# Primary database connection
DATABASE_URI=postgresql://admin:supersecretpassword@puipostgres:5432/appdb

# Additional databases (optional — uncomment as needed)
# DATABASE_URI_PUI=postgresql://user:pass@host:5432/pui_db
# DATABASE_URI_CEVI=mysql://user:pass@host:3306/cevi_db

# Access mode: "restricted" (read-only) or "admin" (full access)
MCP_ACCESS_MODE=restricted

# Authentication (Plain text format 'username:password')
MCP_BASIC_AUTH=antigravity:mi_contraseña_segura
