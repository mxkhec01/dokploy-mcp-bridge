# =========================================
# Environment variables for MCP Bridge
# Copy to .env and fill in your values
# =========================================

# Primary database connection
DATABASE_URI=postgresql://admin:supersecretpassword@puipostgres:5432/appdb

# Additional databases (optional — uncomment as needed)
# DATABASE_URI_PUI=postgresql://user:pass@host:5432/pui_db
# DATABASE_URI_CEVI=mysql://user:pass@host:3306/cevi_db

# Access mode: "restricted" (read-only) or "admin" (full access)
ACCESS_MODE=restricted

# MCP transport: "streamable-http", "sse", or "stdio"
MCP_TRANSPORT=streamable-http

# Server binding
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Max rows returned per SQL query (protects LLM context window)
MAX_QUERY_ROWS=100

# BasicAuth for Traefik (htpasswd format, $$ escaped for compose)
# Generate with: htpasswd -nb username password | sed 's/\$/\$\$/g'
# MCP_BASIC_AUTH=antigravity:$$apr1$$...
